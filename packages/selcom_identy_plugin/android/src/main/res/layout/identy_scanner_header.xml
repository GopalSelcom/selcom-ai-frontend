<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="#ffE3F3E4"

    android:orientation="horizontal">

    <ImageView
        android:id="@+id/left_hand_icon"
        android:layout_width="60dp"
        android:padding="10dp"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:layout_alignParentLeft="true"
        android:src="@drawable/left_4f_small_icon"
        android:layout_gravity="center"/>

    <TextView
        android:id="@+id/id_header_title"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center"
        android:layout_toRightOf="@+id/left_hand_icon"
        android:layout_toLeftOf="@id/right_hand_icon"
        android:text=""
        android:textColor="@android:color/black"
        android:textSize="23sp" />

    <ImageView
        android:id="@+id/right_hand_icon"
        android:layout_height="match_parent"
        android:layout_width="60dp"
        android:padding="10dp"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true"
        android:src="@drawable/right_4f_small_icon"
        android:layout_gravity="center"/>
</RelativeLayout>